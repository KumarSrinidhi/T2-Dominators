{
  "site": "Arducam (USB) + ESP32-CAM (Wi-Fi) with PIR",
  "analytics_fps": 5,
  "record": false,
  "correlation_window_s": 15,
  "detector": {
    "weights": "data/models/yolo26n.pt",
    "tracker": "bytetrack.yaml",
    "conf": 0.1,
    "imgsz": 480,
    "device": "auto"
  },
  "map": {
    "width_m": 10,
    "height_m": 8
  },
  "cameras": [
    {
      "id": "arducam",
      "name": "Arducam 16MP (USB)",
      "source": "2",
      "capture": {
        "width": 1280,
        "height": 720,
        "fps": 30,
        "fourcc": "MJPG"
      },
      "zones": [
        {
          "id": "room",
          "name": "Room (Arducam)",
          "criticality": 1,
          "polygon_px": [
            [
              0,
              0
            ],
            [
              1280,
              0
            ],
            [
              1280,
              720
            ],
            [
              0,
              720
            ]
          ],
          "rules": {
            "loitering": {
              "min_seconds": 60
            },
            "crowding": {
              "max_count": 3,
              "min_seconds": 3
            }
          }
        }
      ]
    },
    {
      "id": "esp32cam",
      "name": "ESP32-CAM (entrance)",
      "source": "http://192.168.1.50:81/stream",
      "reconnect_max_s": 10,
      "zones": [
        {
          "id": "entrance",
          "name": "Entrance",
          "site_zone": "entrance",
          "criticality": 2,
          "polygon_px": [
            [
              0,
              0
            ],
            [
              640,
              0
            ],
            [
              640,
              480
            ],
            [
              0,
              480
            ]
          ],
          "rules": {
            "intrusion": {
              "min_seconds": 1
            },
            "loitering": {
              "min_seconds": 30
            }
          }
        }
      ]
    }
  ],
  "poll_sensors": [
    {
      "id": "esp32_pir",
      "url": "http://192.168.1.50/pir",
      "camera": "esp32cam",
      "zone": "entrance",
      "zone_name": "Entrance",
      "site_zone": "entrance",
      "criticality": 1,
      "poll_s": 0.5
    }
  ]
}
