    {
      "id": "mot17",
      "name": "MOT17 multi-object tracking benchmark, train split, FRCNN copies of the 7 sequences (MOTChallenge)",
      "landing": "https://motchallenge.net/data/MOT17/",
      "licence_short": "MOTChallenge terms: research / non-commercial use with citation; do not redistribute",
      "licence": "MOTChallenge data historically published under CC BY-NC-SA 3.0; the archived data page fetched 2026-09-25 restates no licence text (the evaluation service is closed, results frozen 2026-04-16). Treat as non-commercial research use with citation and do not redistribute frames or ground truth.",
      "terms_url": "https://motchallenge.net/data/MOT17/",
      "citation": "A. Milan, L. Leal-Taixe, I. Reid, S. Roth, K. Schindler: MOT16: A Benchmark for Multi-Object Tracking, arXiv:1603.00831",
      "format": "JPEG frame sequences (1920x1080 @ 30 fps; MOT17-05 640x480 @ 14 fps; MOT17-13 1920x1080 @ 25 fps) + gt/gt.txt (frame, id, box, consider, class, visibility)",
      "exercises": "tracking accuracy of detector + ByteTrack (MOTA/MOTP, IDF1, HOTA) at the 5 fps analytics rate and at full frame rate (tools/eval_datasets.py --only mot17)",
      "annotations": "MOTChallenge gt.txt per sequence; the three detector copies (DPM/FRCNN/SDP) share frames and GT, only FRCNN is fetched",
      "size_bytes": 900000000,
      "default": false,
      "fetch": [
        {
          "zip_url": "https://motchallenge.net/data/MOT17.zip",
          "dest_dir": "mot17/raw",
          "strip": 1,
          "members": [
            "MOT17/train/MOT17-02-FRCNN/",
            "MOT17/train/MOT17-04-FRCNN/",
            "MOT17/train/MOT17-05-FRCNN/",
            "MOT17/train/MOT17-09-FRCNN/",
            "MOT17/train/MOT17-10-FRCNN/",
            "MOT17/train/MOT17-11-FRCNN/",
            "MOT17/train/MOT17-13-FRCNN/"
          ]
        }
      ],
      "convert": [
        {
          "frames_dir_glob": "mot17/raw/train/MOT17-0[249]-FRCNN/img1",
          "pattern": "%06d.jpg",
          "fps": 30,
          "name_template": "{parent}",
          "dst_dir": "mot17/mp4",
          "crf": 18
        },
        {
          "frames_dir_glob": "mot17/raw/train/MOT17-1[01]-FRCNN/img1",
          "pattern": "%06d.jpg",
          "fps": 30,
          "name_template": "{parent}",
          "dst_dir": "mot17/mp4",
          "crf": 18
        },
        {
          "frames_dir_glob": "mot17/raw/train/MOT17-05-FRCNN/img1",
          "pattern": "%06d.jpg",
          "fps": 14,
          "name_template": "{parent}",
          "dst_dir": "mot17/mp4",
          "crf": 18
        },
        {
          "frames_dir_glob": "mot17/raw/train/MOT17-13-FRCNN/img1",
          "pattern": "%06d.jpg",
          "fps": 25,
          "name_template": "{parent}",
          "dst_dir": "mot17/mp4",
          "crf": 18
        }
      ],
      "ship": [
        "mot17/mp4/MOT17-??-FRCNN.mp4",
        "mot17/raw/train/*/gt/gt.txt",
        "mot17/raw/train/*/seqinfo.ini"
      ],
      "laptop_subset": []
    }
